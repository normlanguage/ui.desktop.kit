import ui.Renderer
import ui.fx.JavaFxBackend
import ui.fx.JavaFxScheduler
import ui.fx.fxHandle
import ui.Binding
import ui.fx.FxApplication
import ui.fx.kit.App
import ui.fx.kit.Switch
import ui.fx.kit.internal.utilRequireSwitch
import ui.theme.ThemeManager
import ui.theme.ThemeDefinition
import ui.theme.Color

Module module() {
  module(dependencies: [dependency(repository: "github", name: "ui", version: 7), dependency(repository: "github", name: "ui.fx", version: 5), dependency(repository: "github", name: "ui.fx.kit", version: 5), dependency(repository: "github", name: "ui.theme", version: 2)])
}
class State { Boolean enabled = false }
Void main() {
  var application = FxApplication("Component probe")
  var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
  var theme = ThemeManager(definition: ThemeDefinition(primary: Color(hex: "#2563EB")))
  var state = State()
  application.run(build: () {
    renderer.render(App(theme: theme, content: Switch(text: "Switch", value: Binding<Boolean>(read: () { state.enabled }, write: (Boolean value) { state.enabled = value }))))
    application.root(fxHandle(renderer.node()))
    application.later(() {
      try {
        var control = utilRequireSwitch(arg0: application.scene(), arg1: "Switch")!!
        control.fire()
        require(condition: state.enabled, message: "switch writes through its mounted Binding")
        control.fire()
        require(condition: !state.enabled, message: "switch resets its mounted Binding")
        printLine("Native controls verified")
      } finally { application.close() }

    })
  }, dispose: () { renderer.close() theme.close() })
}
