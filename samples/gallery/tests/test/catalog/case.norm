package gallery.test.catalog

import std.testing.Test
import gallery.galleryPages
import gallery.sourceDeclaration

@Test
Void everyComponentHasLiveExampleAndSource() {
  var pages = galleryPages()
  require(condition: pages.size() == 73, message: "The gallery covers every component")
  List<String> names = []
  for page : pages {
    for name : names { require(condition: name != page.name, message: "Component registration must be unique") }
    names.add(page.name)
    var source = sourceDeclaration(file: page.source, symbol: page.symbol)
    require(condition: source.startsWith(prefix: "class " + page.symbol), message: "Documentation reads the live example class")
    var api = sourceDeclaration(file: page.api, symbol: page.apiSymbol)
    require(condition: api.startsWith(prefix: "value " + page.apiSymbol) || api.startsWith(prefix: "class " + page.apiSymbol),
      message: "Documentation reads the public declaration from its owning module")
    require(condition: !page.summary.isBlank && !page.whenToUse.isBlank, message: "Every page explains usage")
  }
}
