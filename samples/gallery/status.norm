package gallery

import ui.CrossAlignment
import ui.Box
import ui.SizeConstraints
import ui.Dimension
import ui.Widget
import ui.Column
import ui.Row
import ui.Text
import ui.Binding
import ui.theme.Color
import ui.theme.ThemeDefinition
import ui.theme.ThemeManager
import ui.fx.kit.Button
import ui.fx.kit.Alert
import ui.fx.kit.Message
import ui.fx.kit.Notification
import ui.fx.kit.Progress
import ui.fx.kit.Result
import ui.fx.kit.Skeleton
import ui.fx.kit.Spin
import ui.fx.kit.Watermark
import ui.fx.kit.Affix
import ui.fx.kit.BorderBeam
import ui.fx.kit.App
import ui.fx.kit.ConfigProvider
import ui.fx.kit.Surface

class AlertExample implements Widget {
  private Boolean closable = true
  Widget build() {
    Column(cross: CrossAlignment.Stretch, gap: 12.0) {
      Alert(title: "请检查填写的信息", content: Text("请补充联系人后继续提交。"), closable: closable)
      Button(text: "切换关闭按钮", action: () { closable = !closable })
    }
  }
}

class MessageExample implements Widget {
  private Boolean visible = false
  Widget build() {
    Column(cross: CrossAlignment.Stretch, gap: 12.0) {
      Button(text: "保存更改", action: () { visible = true })
      Message(text: "更改已保存", open: Binding<Boolean>(read: () { visible }, write: (Boolean next) { visible = next }))
      Text(if visible { "提示正在显示" } else { "提示会自动消失，也会在离开页面时清理" })
    }
  }
}

class NotificationExample implements Widget {
  private Boolean visible = false
  Widget build() {
    Column(cross: CrossAlignment.Stretch, gap: 12.0) {
      Button(text: "查看任务完成通知", action: () { visible = true })
      Notification(title: "导出完成", content: Text("本月的数据报表已经准备就绪。"),
        open: Binding<Boolean>(read: () { visible }, write: (Boolean next) { visible = next }))
      Text(if visible { "点击通知中的关闭按钮" } else { "通知已关闭" })
    }
  }
}

class ProgressExample implements Widget {
  private Double progress = 0.35
  Widget build() {
    Column(cross: CrossAlignment.Stretch, gap: 12.0) {
      Progress(value: progress)
      Row(gap: 10.0) {
        Button(text: "推进", action: () { progress = if progress >= 1.0 { 0.0 } else { progress + 0.1 } })
        Button(text: "等待中", action: () { progress = -1.0 })
      }
    }
  }
}

class ResultExample implements Widget {
  private Boolean success = true
  Widget build() {
    Result(title: if success { "发布成功" } else { "连接失败" },
      description: if success { "内容已准备就绪，可以继续处理下一项。" } else { "检查连接后重试，输入内容仍然保留。" },
      actions: [Button(text: if success { "模拟失败" } else { "重新尝试" }, action: () { success = !success })])
  }
}

class SkeletonExample implements Widget {
  private Boolean loading = true
  Widget build() {
    Column(cross: CrossAlignment.Stretch, gap: 12.0) {
      if loading { Skeleton(lines: 4) } else { Text("项目资料") Text("负责人：林安 · 最近更新：今天") }
      Button(text: if loading { "加载完成" } else { "重新加载" }, action: () { loading = !loading })
    }
  }
}

class SpinExample implements Widget {
  private Boolean loading = false
  Widget build() {
    Column(cross: CrossAlignment.Stretch, gap: 12.0) {
      Spin(content: Box(size: SizeConstraints(width: Dimension.Fill, minHeight: 140.0), content: Text("这部分内容在处理完成后仍然保留")), spinning: loading)
      Button(text: if loading { "完成处理" } else { "开始处理" }, action: () { loading = !loading })
    }
  }
}

class WatermarkExample implements Widget {
  private Boolean confidential = true
  Widget build() {
    Column(cross: CrossAlignment.Stretch, gap: 12.0) {
      Watermark(text: if confidential { "内部资料" } else { "NORM" },
        content: Box(size: SizeConstraints(width: Dimension.Fill, minHeight: 240.0), content: Text("季度项目报告")))
      Button(text: "切换水印", action: () { confidential = !confidential })
    }
  }
}

class AffixExample implements Widget {
  private Integer saved = 0
  Widget build() {
    Box(size: SizeConstraints(width: Dimension.Fill, minHeight: 300.0), content: Affix(
      fixed: Button(text: "保存 " + saved.toString(), action: () { saved = saved + 1 }),
      content: Column(cross: CrossAlignment.Stretch, gap: 12.0) { for section : ["简介", "内容", "协作", "权限", "发布", "历史"] {
        Box(size: SizeConstraints(width: Dimension.Fill, minHeight: 110.0), content: Text(section))
      } }))
  }
}

class BorderBeamExample implements Widget {
  private Boolean animated = true
  Widget build() {
    Column(cross: CrossAlignment.Stretch, gap: 12.0) {
      BorderBeam(animated: animated, content: Box(size: SizeConstraints(width: Dimension.Fill, minHeight: 150.0), content: Text("准备好开始下一个项目")))
      Button(text: if animated { "暂停动画" } else { "继续动画" }, action: () { animated = !animated })
    }
  }
}

class AppExample implements Widget {
  private ThemeManager theme = ThemeManager(ThemeDefinition(primary: Color(hex: "#722ED1")))
  private Boolean visible = false
  Widget build() {
    App(theme: theme, content: Column(cross: CrossAlignment.Stretch, gap: 12.0) {
      Text("这个区域拥有独立的主题和通知容器")
      Button(text: "显示局部通知", action: () { visible = true })
      Message(text: "来自当前 App", open: Binding<Boolean>(read: () { visible }, write: (Boolean next) { visible = next }))
    })
  }
  Void dispose() { theme.close() }
}

class ConfigProviderExample implements Widget {
  private ThemeManager theme = ThemeManager(ThemeDefinition(primary: Color(hex: "#13A874")))
  private Boolean override = true
  Widget build() {
    Column(cross: CrossAlignment.Stretch, gap: 12.0) {
      ConfigProvider(theme: if override { theme } else { null }, content: Button(text: "局部主题操作", action: () {}))
      Button(text: if override { "恢复继承" } else { "启用局部主题" }, action: () { override = !override })
    }
  }
  Void dispose() { theme.close() }
}

class UtilExample implements Widget {
  private Integer count = 0
  Widget build() {
    Column(cross: CrossAlignment.Stretch, gap: 12.0) {
      Text("状态与生命周期由 Norm UI 管理，控件使用相同的组件树。")
      Text("Surface 为组合内容提供样式入口；业务代码无需操作 JavaFX Node。")
      Surface(styleClass: "gallery-preview", content: Row(gap: 10.0) {
        Text("已执行 " + count.toString() + " 次")
        Button(text: "更新状态", action: () { count = count + 1 })
      })
    }
  }
}
