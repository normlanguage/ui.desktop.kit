package guide

import ui.CrossAlignment
import ui.Widget
import ui.Binding
import ui.ForEach
import ui.ValueKey
import ui.NodeKey
import ui.desktop.DesktopApp
import ui.desktop.kit.App
import ui.desktop.kit.ConfigProvider
import ui.UiConfiguration
import ui.UiProvider
import ui.Column
import ui.Row
import ui.Text
import ui.desktop.kit.Input
import ui.desktop.kit.Button
import ui.desktop.kit.Tabs
import ui.desktop.kit.Tab
import ui.theme.ThemeManager
import ui.theme.ThemeDefinition
import ui.theme.ThemeMode
import ui.theme.Color
import ui.theme.Tone
import ui.theme.Appearance

class Notes implements Widget {
  ThemeManager theme
  String draft = ""
  List<String> notes = []
  Integer selected = 0
  Boolean dark = false

  Void save() {
    if draft.isBlank { return }
    for note : notes { if note == draft { return } }
    List<String> next = [for (note : notes) note]
    next.add(draft)
    notes = next
    draft = ""
  }

  Widget build() {
    App(theme: theme, content: Tabs(selected: Binding<Integer>(
      read: () { selected }, write: (Integer next) { selected = next }), tabs: [
      Tab(title: "笔记", key: NodeKey.Named("notes"), content: Column(cross: CrossAlignment.Stretch, gap: 12.0) {
        Row(gap: 10.0) {
          Input(placeholder: "输入笔记", value: Binding<String>(
            read: () { draft }, write: (String next) { draft = next }), submit: this.save)
          Button(key: NodeKey.Named("notes-save"), text: "保存", action: this.save, enabled: !draft.isBlank)
        }
        ForEach<String>(items: notes, identity: (String note) { ValueKey<String>(note) },
          child: (String note) { Text(note) })
      }),
      Tab(title: "设置", key: NodeKey.Named("settings"), content: UiProvider(
        configuration: UiConfiguration(fontSize: 16.0), child: Column(cross: CrossAlignment.Stretch, gap: 12.0) {
          Text("局部字号与全局主题")
          Button(key: NodeKey.Named("notes-theme"), text: if dark { "浅色" } else { "深色" }, tone: Tone.Neutral,
            appearance: Appearance.Soft, action: () {
              dark = !dark
              theme.setMode(if dark { ThemeMode.Dark } else { ThemeMode.Light })
            })
        }))
    ]))
  }
}

Void main() {
  var theme = ThemeManager(ThemeDefinition(primary: Color(hex: "#2563EB")))
  try { DesktopApp(title: "Norm 笔记", home: Notes(theme: theme)).run() }
  finally { theme.close() }
}
