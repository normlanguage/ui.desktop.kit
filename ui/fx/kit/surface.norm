package ui.fx.kit

import ui.Widget
import ui.NodeKey
import ui.fx.kit.internal.Surface as SurfaceControl
import ui.fx.kit.internal.surfaceNew

value Surface implements Widget {
  Widget content
  String styleClass = ""
  NodeKey? key = null
  Widget build() {
    nativeComponent<SurfaceControl>(kind: "ui.fx.kit.Surface", create: () { surfaceNew() },
      node: (control) { control }, update: (control, scope) {
        control.setClassName(styleClass)
      }, children: [content], arrange: (control, nodes) { control.setContent(nodes[0]) },
      close: (control) {}, key: key)
  }
}
