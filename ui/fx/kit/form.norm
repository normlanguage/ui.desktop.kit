package ui.fx.kit

import ui.Widget
import ui.Binding
import ui.Column as UiColumn
import ui.Row as UiRow
import ui.Text as UiText
import ui.CrossAlignment
import ui.WidgetRole
import ui.NodeKey
import std.core.Exception
import std.io.Resource
import std.observation.observeFields

interface FormEntry {
  String name()
  Boolean validate()
  Boolean dirty()
  Void reset()
  Void begin()
  Void accept()
  Void reject(String error)
  Widget view()
}

class FormField<T> implements FormEntry {
  private String fieldName
  private Binding<T> value
  private Function<Widget(Binding<T>)> control
  private Function<Boolean(T)> validator
  private String validationError
  private Function<Boolean(T, T)> equivalent
  private T baseline
  private T submitted
  private String? failure = null
  private Boolean edited = false

  FormField(String name, Binding<T> value, Function<Widget(Binding<T>)> control,
    Function<Boolean(T)> validator, String error, Function<Boolean(T, T)> equivalent = (left, right) { left == right }) {
    fieldName = name
    this.value = value
    this.control = control
    this.validator = validator
    validationError = error
    this.equivalent = equivalent
    baseline = value.value
    submitted = baseline
  }

  String name() { fieldName }
  Boolean dirty() { !equivalent(value.value, baseline) }
  Boolean touched() { edited }
  String? error() { failure }
  Binding<T> binding() {
    Binding<T>(read: () { value.value }, write: (next) {
      value.value = next
      edited = true
      failure = null
    })
  }
  Boolean validate() {
    failure = if validator(value.value) { null } else { validationError }
    failure == null
  }
  Void reset() { value.value = baseline edited = false failure = null }
  Void begin() { submitted = value.value }
  Void accept() { baseline = submitted failure = null }
  Void reject(String error) { if equivalent(value.value, submitted) { failure = error } }
  Widget view() { FormFieldView<T>(field: this, control: control(this.binding())) }
}

private class FormFieldView<T> implements Widget {
  FormField<T> field
  Widget control
  private String? error = null
  private Resource? subscription = null
  private FormField<T>? observed = null

  Widget build() {
    if observed != field {
      subscription?.close()
      observed = field
      error = field.error()
      subscription = observeFields<FormField<T>>(target: field,
        read: (Integer index) {}, changed: (Integer index) { error = field.error() })
    }
    var failure = error
    List<Widget> children = [control]
    if failure != null {
      children.add(UiText(text: failure, role: WidgetRole.Destructive))
    }
    UiColumn(cross: CrossAlignment.Stretch, children: children, gap: 12.0)
  }
  Void dispose() { subscription?.close() subscription = null }
}

class FormSubmission {
  private Function<Void(Boolean, Map<String, String>, String?)>? complete
  FormSubmission(Function<Void(Boolean, Map<String, String>, String?)> complete) { this.complete = complete }
  Void accept() { this.resolve(accepted: true, errors: Map<String, String>(), message: null) }
  Void reject(Map<String, String> fieldErrors = Map<String, String>(), String? message = null) {
    this.resolve(accepted: false, errors: fieldErrors, message: message)
  }
  Void cancel() { this.resolve(accepted: false, errors: Map<String, String>(), message: null) }
  private Void resolve(Boolean accepted, Map<String, String> errors, String? message) {
    var callback = complete
    if callback == null { return }
    complete = null
    callback(accepted, errors, message)
  }
}

class FormController {
  private List<FormEntry> fields
  private FormSubmission? submission = null
  private String? failure = null

  FormController(List<FormEntry> fields) {
    Map<String, Boolean> names = Map<>()
    for field : fields {
      if names.containsKey(field.name()) { throw Exception(message: "Duplicate form field: ${field.name()}") }
      names[field.name()] = true
    }
    this.fields = fields
  }
  Boolean pending() { submission != null }
  List<FormEntry> entries() { fields }
  String? message() { failure }
  Boolean dirty() {
    for field : fields { if field.dirty() { return true } }
    false
  }
  Boolean validate() {
    var valid = true
    for field : fields { if !field.validate() { valid = false } }
    valid
  }
  Boolean submit(Function<Void(FormSubmission)> onSubmit) {
    if this.pending() || !this.validate() { return false }
    failure = null
    for field : fields { field.begin() }
    var ticket = FormSubmission((accepted, errors, message) {
      submission = null
      Integer matched = 0
      for field : fields { if errors.containsKey(field.name()) { matched = matched + 1 } }
      if matched != errors.size() { throw Exception(message: "Form errors contain an unregistered field") }
      failure = message
      if accepted { for field : fields { field.accept() } }
      else {
        for field : fields {
          var error = errors.get(key: field.name())
          if error != null { field.reject(error) }
        }
      }
    })
    submission = ticket
    Boolean returned = false
    try { onSubmit(ticket) returned = true }
    finally { if !returned { ticket.cancel() } }
    true
  }
  Void cancel() { submission?.cancel() submission = null }
  Void reset() { this.cancel() failure = null for field : fields { field.reset() } }
}

value Form implements Widget {
  FormController controller
  Function<Void(FormSubmission)> onSubmit
  String submitText = "提交"
  String resetText = "重置"

  Boolean validate() { controller.validate() }
  Boolean submit() { controller.submit(onSubmit) }
  Void reset() { controller.reset() }
  Widget build() { FormView(controller: controller, onSubmit: onSubmit, submitText: submitText, resetText: resetText) }
}

private class FormView implements Widget {
  FormController controller
  Function<Void(FormSubmission)> onSubmit
  String submitText
  String resetText
  private Boolean pending = false
  private String? failure = null
  private Resource? subscription = null
  private FormController? observed = null

  Widget build() {
    if observed != controller {
      subscription?.close()
      observed?.cancel()
      observed = controller
      pending = controller.pending()
      failure = controller.message()
      subscription = observeFields<FormController>(target: controller,
        read: (Integer index) {}, changed: (Integer index) {
          pending = controller.pending()
          failure = controller.message()
        })
    }
    List<Widget> content = []
    for field : controller.entries() { content.add(field.view()) }
    var error = failure
    if error != null { content.add(UiText(text: error, role: WidgetRole.Destructive)) }
    content.add(UiRow(key: NodeKey.Named("form-actions"), children: [
      Button(text: if pending { "提交中" } else { submitText }, enabled: !pending, action: () { controller.submit(onSubmit) return }),
      Button(text: resetText, enabled: !pending, action: () { controller.reset() })
    ], gap: 10.0))
    UiColumn(cross: CrossAlignment.Stretch, children: content, gap: 12.0)
  }
  Void dispose() { subscription?.close() subscription = null controller.cancel() }
}
