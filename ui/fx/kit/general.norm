package ui.fx.kit

import ui.Widget
import ui.NodeKey
import ui.Binding
import ui.theme.Tone
import ui.theme.Appearance
import ui.fx.kit.internal.Button as ButtonControl
import ui.fx.kit.internal.buttonNew
import ui.fx.kit.internal.styleButton
import ui.fx.kit.internal.utilCloseNode
import ui.fx.kit.internal.Icon as IconControl
import ui.fx.kit.internal.Typography as TypographyControl
import ui.fx.kit.internal.FloatButtonHost
import ui.fx.kit.internal.iconNew
import ui.fx.kit.internal.typographyNew
import ui.fx.kit.internal.navigationLayoutAdapterFloatButton
import ui.fx.kit.internal.navigationLayoutAdapterFloatButtonContent
import ui.fx.kit.internal.navigationLayoutAdapterButtonAction

value Button implements Widget {
  String text
  Function<Void()> action
  Boolean enabled = true
  Boolean loading = false
  Tone tone = Tone.Primary
  Appearance appearance = Appearance.Filled
  NodeKey? key = null

  Widget build() {
    nativeComponent<ButtonControl>(kind: "ui.fx.kit.Button",
      create: () { buttonNew(text) }, node: (control) { control },
      update: (control, scope) {
        control.setText(text)
        control.setLoading(loading)
        styleButton(control: control, tone: tone, appearance: appearance)
        var callback = scope.bind(action)
        navigationLayoutAdapterButtonAction(arg0: control, arg1: callback)
      }, close: (control) { control.close() }, key: key, enabled: enabled)
  }
}

value FloatButton implements Widget {
  String text
  Widget content
  Function<Void()> action
  NodeKey? key = null

  Widget build() {
    nativeComponent<FloatButtonHost>(kind: "ui.fx.kit.FloatButton",
      create: () { navigationLayoutAdapterFloatButton(text)!! }, node: (host) { host.node()!! },
      update: (host, scope) {
        host.title(text)
        host.action(scope.bind(action))
      }, children: [content],
        arrange: (host, nodes) { navigationLayoutAdapterFloatButtonContent(arg0: host, arg1: nodes[0]) },
      close: (host) { host.close() }, key: key)
  }
}

value Icon implements Widget {
  String literal
  Integer size = 16
  NodeKey? key = null

  Widget build() {
    nativeComponent<IconControl>(kind: "ui.fx.kit.Icon",
      create: () { iconNew(literal) }, node: (control) { control },
      update: (control, scope) {
        control.setIconLiteral(literal)
        control.setIconSize(size)
      }, close: (control) { utilCloseNode(control) }, key: key)
  }
}

value Typography implements Widget {
  String text
  Boolean copyable = false
  Binding<String>? edited = null
  NodeKey? key = null

  Widget build() {
    nativeComponent<TypographyControl>(kind: "ui.fx.kit.Typography",
      create: () { typographyNew(text) }, node: (control) { control },
      update: (control, scope) {
        var current = edited
        control.setText(if current != null { current.value } else { text })
        control.setCopyable(copyable)
        control.setEditable(current != null)
        if current != null {
          var changed = scope.bind((String next) { current.value = next })
          control.setOnEditCommit((event) { changed(control.getText()!!) })
        } else { control.setOnEditCommit(null) }
      }, close: (control) { utilCloseNode(control) }, key: key)
  }
}
