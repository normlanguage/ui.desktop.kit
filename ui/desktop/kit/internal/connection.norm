package ui.desktop.kit.internal

import ui.desktop.toneName
import ui.desktop.appearanceName
import ui.theme.Tone
import ui.theme.Appearance
import ui.theme.ControlState
import ui.desktop.native.Node
import std.filesystem.Path
import java.base.io.fileNew

Void uploadFiles(Upload upload, List<Path> files) {
  for file : files { upload.addFile(fileNew(file.value)!!) }
}

Button button(String text, Tone tone = Tone.Primary, Appearance appearance = Appearance.Filled, Boolean selected = false) {
  var control = buttonNew(text)
  styleButton(control: control, tone: tone, appearance: appearance, selected: selected)
  control
}

Void styleButton(Button control, Tone tone = Tone.Primary, Appearance appearance = Appearance.Filled, Boolean selected = false) {
  var prefix = "-norm-" + toneName(tone) + "-" + appearanceName(appearance)
  if selected { prefix = prefix + "-selected" }
  var css = ""
  for state : ["normal", "hovered", "pressed", "disabled"] {
    for part : ["background", "foreground", "border"] {
      css = css + "-norm-button-" + state + "-" + part + ": " + prefix + "-" + state + "-" + part + ";"
    }
  }
  control.setStyle(css)
}


Void styleSurface(Node control, Tone tone = Tone.Neutral, Appearance appearance = Appearance.Soft) {
  var prefix = "-norm-" + toneName(tone) + "-" + appearanceName(appearance)
  utilStyle(arg0: control, arg1: "-norm-surface-background: " + prefix + "-normal-background;"
    + "-norm-surface-foreground: " + prefix + "-normal-foreground;"
    + "-norm-surface-border: " + prefix + "-normal-border;"
    + "-norm-surface-hover: " + prefix + "-hovered-background;")
}
