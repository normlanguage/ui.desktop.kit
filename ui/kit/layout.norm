package ui.kit

import ui.Widget
import ui.NodeKey
import ui.kit.fx.javafx.geometry.Orientation
import ui.kit.fx.Divider as DividerControl
import ui.kit.fx.Splitter as SplitterControl
import ui.kit.fx.dividerNew
import ui.kit.fx.navigationLayoutAdapterSplitter
import ui.kit.fx.utilCloseNode
import ui.kit.fx.hostItems

value Divider implements Widget {
  Boolean vertical = false
  NodeKey? key = null

  Widget build() {
    nativeComponent<DividerControl>(kind: "ui.kit.Divider",
      create: () { dividerNew() }, node: (control) { control },
      update: (control, scope) {
        control.setOrientation(if vertical { Orientation.VERTICAL } else { Orientation.HORIZONTAL })
      },
      close: (control) { utilCloseNode(control) }, key: key)
  }
}

value Splitter implements Widget {
  List<Widget> children
  Boolean vertical = false
  Double dividerPosition = 0.5
  NodeKey? key = null

  Widget build() {
    nativeComponent<SplitterControl>(kind: "ui.kit.Splitter",
      create: () { navigationLayoutAdapterSplitter()!! }, node: (control) { control },
      update: (control, scope) {
        control.setOrientation(if vertical { Orientation.VERTICAL } else { Orientation.HORIZONTAL })
      }, children: children,
      arrange: (control, nodes) { navigationLayoutAdapterSplitter(arg0: control, arg1: hostItems(nodes), arg2: dividerPosition) },
      close: (control) { utilCloseNode(control) }, key: key)
  }
}
