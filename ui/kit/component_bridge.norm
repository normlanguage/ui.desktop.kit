package ui.kit

import ui.Widget
import ui.View
import ui.NodeKey
import ui.ViewScope
import ui.UiConfiguration
import ui.fx.nativeComponent as fxComponent
import fx.graphics.Node
import theme.Theme
import ui.kit.fx.kitEnvironmentApply
import ui.kit.fx.kitEnvironmentClear

private class ComponentEnvironment { Node? node = null }

View nativeComponent<T>(String kind, Function<T()> create, Function<Node(T)> node,
    Function<Void(T, ViewScope)> update, Function<Void(T)> close,
    List<Widget> children = [], Function<Void(T, List<Node>)>? arrange = null,
    NodeKey? key = null, Boolean enabled = true, Function<Void(T, Theme?)>? applyTheme = null,
    Function<Void(T, UiConfiguration)>? applyConfiguration = null) {
  var environment = ComponentEnvironment()
  fxComponent<T>(kind: kind, create: create,
    node: (control) { var projected = node(control) environment.node = projected projected },
    update: update, children: children, arrange: arrange, key: key, enabled: enabled,
    applyTheme: applyTheme,
    applyConfiguration: (control, configuration) {
      var projected = node(control)
      environment.node = projected
      kitEnvironmentApply(arg0: projected, arg1: configuration.fontFamily,
        arg2: configuration.fontSize, arg3: configuration.motionEnabled)
      if applyConfiguration != null { applyConfiguration(control, configuration) }
    }, close: (control) {
      var mounted = environment.node
      environment.node = null
      try { if mounted != null { kitEnvironmentClear(mounted) } }
      finally { close(control) }
    })
}
